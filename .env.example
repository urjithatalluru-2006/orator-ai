# Server & Netlify Production Environment Variables Template
# DO NOT COMMIT REAL API KEYS TO GIT OR REPOSITORIES

# Required for Gemini AI Integration (Netlify Environment Variables)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Model Configuration Overrides
GEMINI_LIVE_MODEL=gemini-2.0-flash
GEMINI_FAST_MODEL=gemini-3.6-flash
GEMINI_DEEP_MODEL=gemini-3.6-flash

# Pacing & Coaching Thresholds
INTERVENTION_THRESHOLD=0.60
MAX_SPEED_WPM=195
SILENCE_THRESHOLD_SEC=4.0
